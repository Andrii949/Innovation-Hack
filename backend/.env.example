# Copy to backend/.env for local development. Never commit the real file.
DATABASE_URL=postgresql+psycopg://lab:lab@localhost:5432/lab
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
PUBLIC_BASE_URL=http://localhost:8000
FILES_DIR=files
TIMEZONE=Europe/Warsaw
# Optional: Firebase service-account JSON for push notifications (T17); unset = push off.
# FCM_CREDENTIALS_FILE=/run/secrets/fcm.json
OCR_API_URL=
OCR_API_KEY=
OCR_MODEL=qwen-vl-max
OCR_TIMEOUT_S=30
