# docker compose reads this file from infra/ when copied to infra/.env.
# Never commit real secrets.

# Caddy domain (use a real hostname on the test server for automatic Let's Encrypt HTTPS).
DOMAIN=localhost
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# PostgreSQL owner role (used for migrations and backups) and least-privilege app role.
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
POSTGRES_DB=lab
POSTGRES_PORT=5432
APP_DB_USER=lab_app
APP_DB_PASSWORD=lab_app

# API runtime configuration.
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost:5173
PUBLIC_BASE_URL=https://localhost
TIMEZONE=Europe/Warsaw

# Optional Firebase Cloud Messaging credentials path inside the container.
FCM_CREDENTIALS_FILE=

# Optional OpenAI-compatible OCR endpoint (leave empty to keep OCR disabled).
OCR_API_URL=
OCR_API_KEY=
OCR_MODEL=
OCR_TIMEOUT_S=60

# Demo seed settings (leave AUTO_SEED=false unless seeding demo data at startup).
AUTO_SEED=false
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_WORKER_PASSWORD=

# Backup settings used by infra/backup.sh.
BACKUP_DIR=
RETENTION_DAYS=14
